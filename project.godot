; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=1

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Emily like"
run/main_scene="uid://dm1md5v5vp5lu"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TrayManager="*uid://dqujus4mgbvyt"
EarningsManager="*uid://dhq5jk7bccc1v"
WeatherComponent="*uid://dqth3lme014s7"
SaveManager="*uid://6xo48ysq0vlg"

[display]

window/size/viewport_width=1344
window/size/viewport_height=756
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://resources/": "green",
"res://scenes/": "yellow",
"res://scripts/": "orange"
}

[global_group]

Player=""
